# Copy to .env and fill in. Never commit .env.

# --- Medplum -----------------------------------------------------------------
# Leave MEDPLUM_BASE_URL unset for the hosted api.medplum.com.
MEDPLUM_BASE_URL=
# A ClientApplication in your Medplum project, with write access to Task and
# DocumentReference. This is NOT the web app's client id.
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# --- Webhook -----------------------------------------------------------------
# Where Medplum posts each new DocumentReference. Set after the first deploy,
# then re-run the subscription setup.
WEBHOOK_URL=https://<your-deployment>.vercel.app/api/extract
# Shared secret Medplum sends as `Authorization: Bearer <secret>`. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SHARED_SECRET=

# --- AI provider -------------------------------------------------------------
# "gemini" (default) or "claude". Only the selected provider's key is required.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
