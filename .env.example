# Copy to .env and fill in. Never commit .env.

# --- Medplum -----------------------------------------------------------------
# Leave MEDPLUM_BASE_URL unset for the hosted api.medplum.com.
MEDPLUM_BASE_URL=
# A ClientApplication in your Medplum project, with write access to Task and
# DocumentReference. This is NOT the web app's client id.
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# --- Webhook -----------------------------------------------------------------
# Where Medplum posts each new DocumentReference. Set after the first deploy,
# then re-run the subscription setup.
WEBHOOK_URL=https://<your-deployment>.vercel.app/api/extract
# Shared secret Medplum sends as `Authorization: Bearer <secret>`. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SHARED_SECRET=

# --- AI provider -------------------------------------------------------------
# "gemini" (default), "claude" or "openrouter". Only the selected provider's
# credentials are required — getProvider() ignores the rest.
AI_PROVIDER=openrouter
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# OpenRouter. No model default on purpose: ids get retired, and a stale default
# would fail at runtime instead of at setup. Pick one that accepts images from
#   https://openrouter.ai/models?modality=text+image-%3Etext
# A ":free" suffix means the provider may train on what you send — see README
# before pointing it at real patient documents.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
